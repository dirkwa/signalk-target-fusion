{
  "name": "signalk-target-fusion",
  "version": "0.2.0",
  "description": "Links radar and camera targets to the AIS vessels they see, so Signal K clients show and alarm each boat once",
  "author": "Dirk Wahrheit",
  "main": "plugin/index.js",
  "type": "module",
  "scripts": {
    "format": "prettier --write . && eslint --fix .",
    "ci-lint": "eslint . && prettier --check .",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "test": "vitest run",
    "build:all": "npm run ci-lint && npm run typecheck && npm run build && npm run test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-ais",
    "radar",
    "arpa",
    "ais",
    "sensor-fusion"
  ],
  "signalk": {
    "displayName": "Target Fusion",
    "appIcon": "./assets/icon.svg",
    "screenshots": [
      "./docs/screenshots/fused-target.png"
    ]
  },
  "files": [
    "plugin/**/*",
    "assets/icon.svg",
    "docs/screenshots/*.png"
  ],
  "engines": {
    "node": ">=22.15.0",
    "signalk": ">=2.31.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@signalk/server-api": "^2.33.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jiti": "^2.7.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dirkwa/signalk-target-fusion.git"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "typebox": "^1.3.35"
  }
}
