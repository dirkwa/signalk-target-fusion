{
  "compilerOptions": {
    "target": "ES2022",
    // Real ESM output: nodenext makes tsc require the `.js` extension on
    // relative imports, which Node's ESM loader needs at runtime.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "plugin", "test"]
}
